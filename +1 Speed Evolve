local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Event = ReplicatedStorage.Modules.Shared.RemoteEventService.TreadmillRemoteEvent
local treadmillTarget = workspace:WaitForChild("Treadmills"):WaitForChild("Rebirth10")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TeleportGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 280)
frame.Position = UDim2.new(0, 20, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "Teleport Controller"
title.Font = Enum.Font.SourceSansBold
title.TextSize = 20
title.TextColor3 = Color3.new(1, 1, 1)
title.Parent = frame

local function createInput(labelText, position)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 60, 0, 24)
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.Font = Enum.Font.SourceSans
    label.TextSize = 18
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 170, 0, 28)
    box.Position = position + UDim2.new(0, 70, 0, 0)
    box.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    box.BorderSizePixel = 0
    box.TextColor3 = Color3.new(1, 1, 1)
    box.PlaceholderText = "0"
    box.Font = Enum.Font.SourceSans
    box.TextSize = 18
    box.ClearTextOnFocus = false
    box.Parent = frame

    return box
end

local xInput = createInput("X:", UDim2.new(0, 0, 0, 40))
local yInput = createInput("Y:", UDim2.new(0, 0, 0, 75))
local zInput = createInput("Z:", UDim2.new(0, 0, 0, 110))

local startButton = Instance.new("TextButton")
startButton.Size = UDim2.new(0, 120, 0, 34)
startButton.Position = UDim2.new(0, 10, 1, -82)
startButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
startButton.Text = "Start"
startButton.Font = Enum.Font.SourceSansBold
startButton.TextSize = 18
startButton.TextColor3 = Color3.new(1, 1, 1)
startButton.Parent = frame

local stopButton = Instance.new("TextButton")
stopButton.Size = UDim2.new(0, 120, 0, 34)
stopButton.Position = UDim2.new(0, 130, 1, -82)
stopButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
stopButton.Text = "Stop"
stopButton.Font = Enum.Font.SourceSansBold
stopButton.TextSize = 18
stopButton.TextColor3 = Color3.new(1, 1, 1)
stopButton.Parent = frame

local spamStartButton = Instance.new("TextButton")
spamStartButton.Size = UDim2.new(0, 120, 0, 34)
spamStartButton.Position = UDim2.new(0, 10, 1, -44)
spamStartButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
spamStartButton.Text = "Spam Start"
spamStartButton.Font = Enum.Font.SourceSansBold
spamStartButton.TextSize = 18
spamStartButton.TextColor3 = Color3.new(1, 1, 1)
spamStartButton.Parent = frame

local spamStopButton = Instance.new("TextButton")
spamStopButton.Size = UDim2.new(0, 120, 0, 34)
spamStopButton.Position = UDim2.new(0, 130, 1, -44)
spamStopButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
spamStopButton.Text = "Spam Stop"
spamStopButton.Font = Enum.Font.SourceSansBold
spamStopButton.TextSize = 18
spamStopButton.TextColor3 = Color3.new(1, 1, 1)
spamStopButton.Parent = frame

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -20, 0, 24)
statusLabel.Position = UDim2.new(0, 10, 0, 190)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = "Status: stopped"
statusLabel.Font = Enum.Font.SourceSans
statusLabel.TextSize = 16
statusLabel.TextColor3 = Color3.new(1, 1, 1)
statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.Parent = frame

local running = false
local spamRunning = false
local targetPosition = Vector3.new(0, 0, 0)

local function updateStatus(text)
    statusLabel.Text = "Status: " .. text
end

local teleportThread
local spamThread

startButton.MouseButton1Click:Connect(function()
    local x = tonumber(xInput.Text)
    local y = tonumber(yInput.Text)
    local z = tonumber(zInput.Text)

    if not x or not y or not z then
        updateStatus("invalid coordinates")
        return
    end

    targetPosition = Vector3.new(x, y, z)
    running = true
    updateStatus("teleporting to " .. x .. ", " .. y .. ", " .. z)

    if not teleportThread then
        teleportThread = task.spawn(function()
            while running do
                local character = player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(targetPosition)
                end
                task.wait(1)
            end
            teleportThread = nil
        end)
    end
end)

stopButton.MouseButton1Click:Connect(function()
    running = false
    updateStatus("teleport stopped")
end)

local function startSpam()
    if spamRunning then
        return
    end

    spamRunning = true
    updateStatus("spamming treadmill event")

    if not spamThread then
        spamThread = task.spawn(function()
            while spamRunning do
                Event:FireServer(treadmillTarget)
                task.wait(0)
            end
            spamThread = nil
        end)
    end
end

spamStartButton.MouseButton1Click:Connect(startSpam)

spamStopButton.MouseButton1Click:Connect(function()
    spamRunning = false
    updateStatus("spam stopped")
end)

startSpam()

-- ===== AIMBOT =====
-- Hold the aim key and the camera turns so the target closest to your cursor moves onto your cursor.
--   1. Target: the closest on-screen target to the cursor, inside the FOV circle. The circle is
--      drawn from the same cursor position and radius, so what you see is what gets picked.
--   2. Aim: it works out the exact camera yaw and pitch that put that target under the cursor,
--      using the real 3D direction through the cursor. This is correct even when the cursor
--      isn't in the middle of the screen.
--   3. Move: the camera turns toward that yaw/pitch. SMOOTHNESS 1 = instant, lower = slower.
--      The speed is the same at any frame rate, and the camera never rolls.
local MAX_PITCH = math.rad(80) -- same up/down look limit as Roblox's default camera

-- Distance in pixels from the cursor to where `part` shows on screen
-- (nil if it isn't on screen or is farther away than MAX_STUDS)
local function cursorDistance(camera, part, mousePos)
	if (part.Position - camera.CFrame.Position).Magnitude > MAX_STUDS then
		return nil
	end
	local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen then
		return nil
	end
	return (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
end

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude

local function refreshWallParams(camera)
	local list = { camera }
	if player.Character then
		table.insert(list, player.Character)
	end
	local viewmodel = workspace:FindFirstChild("FirstPerson")
	if viewmodel then
		table.insert(list, viewmodel)
	end
	wallParams.FilterDescendantsInstances = list
end

-- True if nothing solid is between the camera and the part
local function canSee(camera, part)
	local origin = camera.CFrame.Position
	local result = workspace:Raycast(origin, part.Position - origin, wallParams)
	if not result or result.Instance == part then
		return true
	end
	if TARGET_TAG then
		return false
	end
	local model = part:FindFirstAncestorOfClass("Model")
	return model ~= nil and result.Instance:IsDescendantOf(model)
end

-- The target closest to the cursor that is inside the FOV circle (nil if there isn't one)
local function getClosestTarget(camera, mousePos)
	local closest = nil
	local shortestDistance = FOV_RADIUS

	if aimWallCheck then
		refreshWallParams(camera)
	end

	if TARGET_TAG then
		for _, part in ipairs(CollectionService:GetTagged(TARGET_TAG)) do
			if part:IsA("BasePart") then
				local distance = cursorDistance(camera, part, mousePos)
				if distance and distance < shortestDistance and (not aimWallCheck or canSee(camera, part)) then
					closest = part
					shortestDistance = distance
				end
			end
		end
	else
		for _, other in ipairs(Players:GetPlayers()) do
			local character = other.Character
			if other ~= player and character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local part = getBodyPart(character, resolveAimPart(character))
				if humanoid and humanoid.Health > 0 and part and part:IsA("BasePart") then
					local distance = cursorDistance(camera, part, mousePos)
					if distance and distance < shortestDistance and (not aimWallCheck or canSee(camera, part)) then
						closest = part
						shortestDistance = distance
					end
				end
			end
		end
	end

	return closest
end

local function aimStep(dt)
	if not aiming or not aimEnabled then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		report("camera", "Aimbot: no camera found, can't aim.", true)
		return
	end

	if TARGET_TAG and #CollectionService:GetTagged(TARGET_TAG) == 0 then
		report("notag", "No parts have the tag \"" .. TARGET_TAG .. "\". Tag your targets in Studio or set TARGET_TAG = nil.", true)
		return
	end

	local mousePos = UserInputService:GetMouseLocation()
	local target = getClosestTarget(camera, mousePos)
	if not target then
		return -- nothing inside the FOV circle is normal, not an error
	end

	local cf = camera.CFrame
	local origin = cf.Position

	-- Direction from the camera to the target
	local toTarget = target.Position - origin
	if toTarget.Magnitude < 0.01 then
		return
	end
	local targetDir = toTarget.Unit

	-- Direction through the cursor, in the camera's own space (x = right, y = up, -z = forward)
	local cursorDir = camera:ViewportPointToRay(mousePos.X, mousePos.Y).Direction.Unit
	local cursorLocal = cf:VectorToObjectSpace(cursorDir)
	local dx = cursorLocal.X
	local dy = cursorLocal.Y
	local forward = -cursorLocal.Z
	if forward < 0.01 then
		return
	end

	-- PITCH: for a camera pitched by p, the cursor direction's height in the world is
	-- dy*cos(p) + forward*sin(p). Solve for the p that makes that equal the target's height.
	local reach = math.sqrt(dy * dy + forward * forward)
	local wantPitch = math.asin(math.clamp(targetDir.Y / reach, -1, 1)) - math.atan2(dy, forward)
	wantPitch = math.clamp(wantPitch, -MAX_PITCH, MAX_PITCH)

	-- YAW: with that pitch fixed, turn sideways until the cursor direction lines up with the target
	local side = dy * math.sin(wantPitch) - forward * math.cos(wantPitch)
	local wantYaw = math.atan2(side, dx) - math.atan2(targetDir.Z, targetDir.X)

	-- Where the camera is pointing now
	local look = cf.LookVector
	local curPitch = math.asin(math.clamp(look.Y, -1, 1))
	local curYaw = math.atan2(-look.X, -look.Z)

	-- Shortest way around for the yaw (so it never spins the long way)
	local yawDiff = (wantYaw - curYaw + math.pi) % (2 * math.pi) - math.pi

	-- Move toward it. SMOOTHNESS 1 snaps; lower closes that fraction of the gap per 1/60 s,
	-- so it feels the same at 30, 60 or 240 fps.
	local alpha = 1
	if SMOOTHNESS < 1 then
		alpha = 1 - (1 - SMOOTHNESS) ^ (math.min(dt, 0.1) * 60)
	end

	local newYaw = curYaw + yawDiff * alpha
	local newPitch = curPitch + (wantPitch - curPitch) * alpha

	camera.CFrame = CFrame.new(origin) * CFrame.Angles(0, newYaw, 0) * CFrame.Angles(newPitch, 0, 0)
end

-- ===== SCRIPTABLE CAMERA SUPPORT =====
-- With Roblox's default camera, whatever direction we leave the camera in simply stays.
-- If your game uses its own camera script (CameraType = Scriptable), that script keeps its own
-- stored angles and puts the camera back to them when we stop, which is the "snap back".
-- Fix without touching that script: we remember how far our aim has turned the camera away
-- from what the game's script wants (an offset), and apply that offset on top of the game's
-- angles every frame. When you let go, the offset stays, so the camera stays where you aimed,
-- and moving the mouse afterwards still works normally on top of it.
local offsetYaw = 0
local offsetPitch = 0
local lastApplied = nil -- the camera CFrame we set last frame
local lastBase = nil    -- what the game's camera script wanted at that time

local function viewAngles(cf)
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z), math.asin(math.clamp(look.Y, -1, 1))
end

local function sameView(a, b)
	return (a.Position - b.Position).Magnitude < 0.001
		and a.LookVector:Dot(b.LookVector) > 0.999999
		and a.UpVector:Dot(b.UpVector) > 0.999999
end

local function resetOffset()
	offsetYaw = 0
	offsetPitch = 0
	lastApplied = nil
	lastBase = nil
end

-- A fresh body means a fresh start
characterAddedConnection = player.CharacterAdded:Connect(resetOffset)

local function cameraStep(dt)
	local camera = workspace.CurrentCamera
	if not camera or camera.CameraType ~= Enum.CameraType.Scriptable then
		-- Default camera: it keeps the direction we leave it with, nothing extra needed
		resetOffset()
		aimStep(dt)
		return
	end

	-- Nothing to do while we aren't aiming and have no leftover offset
	if not (aiming and aimEnabled) and offsetYaw == 0 and offsetPitch == 0 then
		lastApplied = nil
		lastBase = nil
		return
	end

	-- What does the game's camera script want this frame? If the camera is still exactly what
	-- we set last frame, nobody wrote to it, so its wish is unchanged. Otherwise it wrote a new one.
	local current = camera.CFrame
	local base = current
	if lastApplied and lastBase and sameView(current, lastApplied) then
		base = lastBase
	end
	local baseYaw, basePitch = viewAngles(base)

	-- Game's angles + our offset
	local yaw = baseYaw + offsetYaw
	local pitch = math.clamp(basePitch + offsetPitch, -MAX_PITCH, MAX_PITCH)
	camera.CFrame = CFrame.new(base.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)

	-- Let the aimbot turn the camera further if the aim key is held
	aimStep(dt)

	-- Remember how far we are from the game's angles
	local final = camera.CFrame
	local finalYaw, finalPitch = viewAngles(final)
	offsetYaw = (finalYaw - baseYaw + math.pi) % (2 * math.pi) - math.pi
	offsetPitch = finalPitch - basePitch
	lastApplied = final
	lastBase = base
end

-- If the loop errors several frames in a row, it shuts itself off instead of spamming
local MAX_ERRORS = 5
local aimErrorCount = 0

-- Runs right after the default camera update so our lock isn't overwritten
RunService:BindToRenderStep("AimLock", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local ok, err = pcall(cameraStep, dt)
	if ok then
		aimErrorCount = 0
		return
	end

	aimErrorCount += 1
	report("aim_runtime", "Aimbot error: " .. tostring(err), true)

	if aimErrorCount >= MAX_ERRORS then
		RunService:UnbindFromRenderStep("AimLock")
		aimEnabled = false
		if uiSetAim then
			uiSetAim(false)
		end
		local msg = "Aimbot stopped after " .. MAX_ERRORS .. " errors in a row. Last error: " .. tostring(err)
		warn(LOG_PREFIX .. msg)
		notify(msg)
	end
end)

-- ===== TRIGGERBOT =====
-- Clicks automatically while an enemy is under your cursor AND you are holding the aim key (right mouse).
--   Delay: the enemy has to stay under the cursor this long before the first click.
--   Wall check: on = a wall between you and the enemy blocks it; off = it shoots through walls.
--   Max studs: it only fires on targets closer than this.
-- Firing logic: mouse1press, a short wait, mouse1release (falls back to mouse1click, and if none of
-- those exist, to Tool:Activate() on the tool you're holding).

local function clickOnce()
	if mouse1press and mouse1release then
		mouse1press()
		task.wait(0.005)
		mouse1release()
	elseif mouse1click then
		mouse1click()
	else
		local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
		if tool then
			tool:Activate()
		end
	end
end

-- True while the cursor is on top of the control panel, so the triggerbot never clicks the panel itself
local function cursorOverPanel(mousePos)
	if not panelFrame or not screenGui or not screenGui.Enabled then
		return false
	end
	local pos = panelFrame.AbsolutePosition + GuiService:GetGuiInset()
	local size = panelFrame.AbsoluteSize
	return mousePos.X >= pos.X and mousePos.X <= pos.X + size.X
		and mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y
end

-- True if a valid target is under the cursor right now
local function targetUnderCursor()
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end

	local mousePos = UserInputService:GetMouseLocation()
	if cursorOverPanel(mousePos) then
		return false
	end
	local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y)

	local params = RaycastParams.new()
	local list = {}
	if triggerWallCheck then
		-- Ignore your own stuff; the first thing the ray hits must be a target, so walls block it
		params.FilterType = Enum.RaycastFilterType.Exclude
		if player.Character then
			table.insert(list, player.Character)
		end
		table.insert(list, camera)
		local viewmodel = workspace:FindFirstChild("FirstPerson") -- your viewmodel, so it doesn't block the ray
		if viewmodel then
			table.insert(list, viewmodel)
		end
	else
		-- Only targets can be hit, so it shoots through walls
		params.FilterType = Enum.RaycastFilterType.Include
		if TARGET_TAG then
			for _, part in ipairs(CollectionService:GetTagged(TARGET_TAG)) do
				table.insert(list, part)
			end
		else
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player and other.Character then
					table.insert(list, other.Character)
				end
			end
		end
	end
	params.FilterDescendantsInstances = list

	local result = workspace:Raycast(ray.Origin, ray.Direction * triggerMaxStuds, params)
	if not result then
		return false
	end

	if TARGET_TAG then
		return CollectionService:HasTag(result.Instance, TARGET_TAG)
	end

	local model = result.Instance:FindFirstAncestorOfClass("Model")
	local other = model and Players:GetPlayerFromCharacter(model)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	return other ~= nil and other ~= player
		and humanoid ~= nil and humanoid.Health > 0
		and not isTeammate(other)
end

local MAX_TRIGGER_ERRORS = 5
local triggerErrorCount = 0
local triggerAcquiredAt = nil
local triggerSpamming = false
local triggerConnection

-- Counts an error and shuts the triggerbot off after too many in a row
local function handleTriggerError(err)
	triggerErrorCount += 1
	report("trigger_runtime", "Triggerbot error: " .. tostring(err), true)

	if triggerErrorCount >= MAX_TRIGGER_ERRORS then
		if triggerConnection then
			triggerConnection:Disconnect()
		end
		triggerEnabled = false
		if uiSetTrigger then
			uiSetTrigger(false)
		end
		local msg = "Triggerbot stopped after " .. MAX_TRIGGER_ERRORS .. " errors in a row. Last error: " .. tostring(err)
		warn(LOG_PREFIX .. msg)
		notify(msg)
	end
end

-- Spam loop: keeps clicking (press, release, repeat) for as long as the enemy stays under
-- the cursor, then stops. Same idea as a hold-to-spam LMB script, but gated by the target check.
local function startSpam()
	triggerSpamming = true
	task.spawn(function()
		while triggerEnabled and aiming do
			local ok, onTarget = pcall(targetUnderCursor)
			if not ok then
				handleTriggerError(onTarget)
				break
			end
			if not onTarget then
				break -- enemy left the cursor, stop spamming
			end
			triggerErrorCount = 0

			local clicked, clickErr = pcall(clickOnce)
			if not clicked then
				report("trigger_click", "Triggerbot click failed: " .. tostring(clickErr), true)
			end
			task.wait(TRIGGER_CLICK_GAP)
		end
		triggerSpamming = false
	end)
end

-- Watches for an enemy under the cursor; once it has stayed there for the Delay, the spam loop starts
triggerConnection = RunService.Heartbeat:Connect(function()
	if not triggerEnabled or not aiming then
		triggerAcquiredAt = nil
		return
	end
	if triggerSpamming then
		return -- already spamming
	end

	local ok, onTarget = pcall(targetUnderCursor)
	if not ok then
		handleTriggerError(onTarget)
		return
	end
	triggerErrorCount = 0

	if not onTarget then
		triggerAcquiredAt = nil
		return
	end

	triggerAcquiredAt = triggerAcquiredAt or os.clock()
	if (os.clock() - triggerAcquiredAt) * 1000 >= triggerDelay then
		triggerAcquiredAt = nil -- after the enemy leaves, the Delay has to pass again
		startSpam()
	end
end)


		local goalPos = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		local goalColor = state and accent or OFF_COLOR
		local goalGlow = state and 0.4 or 1
		if animate then
			tween(knob, 0.22, { Position = goalPos }, Enum.EasingStyle.Back)
			tween(track, 0.18, { BackgroundColor3 = goalColor })
			tween(glow, 0.18, { Transparency = goalGlow })
		else

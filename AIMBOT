-- ===== BODY PART =====
-- Each group lists the part names to try, in order. R15 rigs have a LowerTorso;
-- R6 rigs only have one "Torso" part, so that is the fallback.
local PART_GROUPS = {
	Head = { "Head" },
	Torso = { "LowerTorso", "Torso", "HumanoidRootPart" },
}

-- Finds the part for "Head" or "Torso" on a character (falls back to the head, then the root part)
local function getBodyPart(character, group)
	for _, name in ipairs(PART_GROUPS[group]) do
		local found = character:FindFirstChild(name)
		if found and found:IsA("BasePart") then
			return found
		end
	end
	return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

-- Random mode: coin flip per target, rolled once per aim press (cleared in the input handlers)
local randomPicks = setmetatable({}, { __mode = "k" })

local function resolveAimPart(character)
	if aimPart ~= "Random" then
		return aimPart
	end
	local pick = randomPicks[character]
	if not pick then
		pick = (math.random() < 0.5) and "Head" or "Torso"
		randomPicks[character] = pick
	end
	return pick
end


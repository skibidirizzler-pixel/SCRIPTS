	-- ===== ANIMATION / STATUS LOOP =====
	local lastStatus = ""
	local frames = 0
	local frameTimer = 0
	guiRenderConnection = RunService.RenderStepped:Connect(function(dt)
	if selfDestructed then
		return
	end
	local t = os.clock()

	-- Rainbow ESP: runs even while the panel is hidden
	if espRainbow and ui.espColor then
		ui.espColor(Color3.fromHSV((t * 0.25) % 1, 1, 1))
	end

	-- Everything below is only visual and not needed while the panel is hidden
	if not gui.Enabled then
		return
	end

	strokeGradient.Rotation = (t * 80) % 360
	ring.Rotation = (t * 45) % 360

		-- Status
		local status, statusColor
		if triggerSpamming then
			status, statusColor = "firing", ACCENT_PINK
		elseif aiming and aimEnabled then
			status, statusColor = "aiming", ACCENT_VIO
		else
			status, statusColor = "idle", TEXT_DIM
		end
		if status ~= lastStatus then
			lastStatus = status
			statusLabel.Text = status
			tween(statusLabel, 0.15, { TextColor3 = statusColor })
		end

		-- FPS (updated twice a second)
		frames += 1
		frameTimer += dt
		if frameTimer >= 0.5 then
			fpsLabel.Text = math.floor(frames / frameTimer + 0.5) .. " fps"
			frames = 0
			frameTimer = 0
		end
	end)

	return gui
end

local okGui, guiOrErr = pcall(buildGui)
if okGui then
	screenGui = guiOrErr
else
	-- No panel means no switches, so the aimbot just stays on while you hold the aim key
	-- (the triggerbot stays off, since it can only be turned on from the panel)
	aimEnabled = true
	report("gui", "Couldn't build the control panel: " .. tostring(guiOrErr) .. ". The aimbot is ON by default without it.", true)
end

print(LOG_PREFIX .. "Loaded. Panel is in " .. guiLocation .. ". Use the panel to turn things on, hold right mouse to aim, " .. GUI_KEY.Name .. " hides the panel.")

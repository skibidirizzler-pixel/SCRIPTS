	nameBtn.Parent = header
	Instance.new("UICorner", nameBtn).CornerRadius = UDim.new(0, 12)

	nameBtn.MouseEnter:Connect(function()
		tween(nameBtn, 0.12, { BackgroundTransparency = 0 })
	end)
	nameBtn.MouseLeave:Connect(function()
		tween(nameBtn, 0.12, { BackgroundTransparency = 1 })
	end)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.new(0, 46, 0, 8)
	nameLabel.Size = UDim2.new(1, -110, 0, 18)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Text = name
	nameLabel.TextSize = 14
	nameLabel.TextColor3 = TEXT_MAIN
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.ZIndex = 2
	nameLabel.Parent = header

	local subLabel = Instance.new("TextLabel")
	subLabel.BackgroundTransparency = 1
	subLabel.Position = UDim2.new(0, 46, 0, 26)
	subLabel.Size = UDim2.new(1, -110, 0, 14)
	subLabel.Font = Enum.Font.Gotham
	subLabel.Text = subtitle
	subLabel.TextSize = 11
	subLabel.TextColor3 = TEXT_DIM
	subLabel.TextXAlignment = Enum.TextXAlignment.Left
	subLabel.ZIndex = 2
	subLabel.Parent = header

	-- Accent bar on the left: grey when off, accent color when on
	local accentBar = Instance.new("Frame")
	accentBar.BackgroundColor3 = OFF_COLOR
	accentBar.BorderSizePixel = 0
	accentBar.AnchorPoint = Vector2.new(0, 0.5)
	accentBar.Position = UDim2.new(0, 12, 0.5, 0)
	accentBar.Size = UDim2.fromOffset(3, 22)
	accentBar.ZIndex = 2
	accentBar.Parent = header
	Instance.new("UICorner", accentBar).CornerRadius = UDim.new(1, 0)

	-- Arrow: points right when closed, turns to point down when open
	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Position = UDim2.new(0, 30, 0.5, 0)
	arrow.Size = UDim2.fromOffset(14, 14)
	arrow.Font = Enum.Font.GothamBold
	arrow.Text = ">"
	arrow.TextSize = 13
	arrow.TextColor3 = TEXT_DIM
	arrow.Rotation = open and 90 or 0
	arrow.ZIndex = 2
	arrow.Parent = header

	local ready = false
	local function renderOn(on, animate)
		local barColor = on and accent or OFF_COLOR
		local strokeColor = on and accent or CARD_STROKE
		local strokeTransparency = on and 0.35 or 0
		local subColor = on and lighten(accent, 0.25) or TEXT_DIM
		local bgColor = on and CARD_BG:Lerp(accent, 0.07) or CARD_BG
		if animate then
			tween(accentBar, 0.2, { BackgroundColor3 = barColor })
			tween(sectionStroke, 0.2, { Color = strokeColor, Transparency = strokeTransparency })
			tween(subLabel, 0.2, { TextColor3 = subColor })
			tween(section, 0.25, { BackgroundColor3 = bgColor })
		else
			accentBar.BackgroundColor3 = barColor
			sectionStroke.Color = strokeColor
			sectionStroke.Transparency = strokeTransparency
			subLabel.TextColor3 = subColor
			section.BackgroundColor3 = bgColor
		end
	end

	local track, setOn = createSwitch(header, initialOn, accent, function(v)
		renderOn(v, ready)
		onToggle(v)
	end)
	ready = true
	track.AnchorPoint = Vector2.new(1, 0.5)
	track.Position = UDim2.new(1, -12, 0.5, 0)
	track.ZIndex = 3

	-- The dropdown: a clipping frame whose height is tweened, with the real content inside it
	local bodyClip = Instance.new("Frame")
	bodyClip.Name = "BodyClip"
	bodyClip.BackgroundTransparency = 1
	bodyClip.ClipsDescendants = true
	bodyClip.LayoutOrder = 1
	bodyClip.Size = UDim2.new(1, 0, 0, 0)
	bodyClip.Parent = section

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Size = UDim2.new(1, 0, 0, 0)
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.Parent = bodyClip

	local bodyLayout = Instance.new("UIListLayout")
	bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bodyLayout.Padding = UDim.new(0, 4)
	bodyLayout.Parent = body

	local bodyPadding = Instance.new("UIPadding")
	bodyPadding.PaddingTop = UDim.new(0, 2)
	bodyPadding.PaddingLeft = UDim.new(0, 12)
	bodyPadding.PaddingRight = UDim.new(0, 12)
	bodyPadding.PaddingBottom = UDim.new(0, 12)
	bodyPadding.Parent = body

	local function contentHeight()
		return body.AbsoluteSize.Y / (panelScale and panelScale.Scale or 1)
	end

	local heightTween = nil
	local function applyHeight(animate)
		local goal = open and contentHeight() or 0
		if heightTween then
			heightTween:Cancel()
			heightTween = nil
		end
		if animate then
			heightTween = tween(bodyClip, 0.3, { Size = UDim2.new(1, 0, 0, goal) }, Enum.EasingStyle.Quint)
		else
			bodyClip.Size = UDim2.new(1, 0, 0, goal)
		end
	end

	-- If the content changes size while the dropdown is open, follow it
	body:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if open then
			applyHeight(false)
		end
	end)

	nameBtn.MouseButton1Click:Connect(function()
		open = not open
		applyHeight(true)
		tween(arrow, 0.2, { Rotation = open and 90 or 0 }, Enum.EasingStyle.Back)
		tween(arrow, 0.2, { TextColor3 = open and lighten(accent, 0.2) or TEXT_DIM })
	end)

	renderOn(initialOn, false)
	applyHeight(false)
	return body, setOn
end

-- Drag `frame` around by holding `handle`; stays inside the screen
local function makeDraggable(frame, handle, gui)
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local dragStart = input.Position
			-- Switch from "centered" to a plain top-left position so dragging and resizing behave
			local startOffset = frame.AbsolutePosition - gui.AbsolutePosition
			frame.AnchorPoint = Vector2.zero
			frame.Position = UDim2.fromOffset(startOffset.X, startOffset.Y)

			activeDrag = {
				update = function(moved)
					local delta = moved.Position - dragStart
					local bounds = gui.AbsoluteSize - frame.AbsoluteSize
					local x = math.clamp(startOffset.X + delta.X, 0, math.max(bounds.X, 0))
					local y = math.clamp(startOffset.Y + delta.Y, 0, math.max(bounds.Y, 0))
					frame.Position = UDim2.fromOffset(x, y)
				end,
				finish = function() end,
			}
		end
	end)

	-- Opening a dropdown makes the panel taller: keep it on screen
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if frame.AnchorPoint ~= Vector2.zero then
			return
		end
		local offset = frame.AbsolutePosition - gui.AbsolutePosition
		local bounds = gui.AbsoluteSize - frame.AbsoluteSize
		local x = math.clamp(offset.X, 0, math.max(bounds.X, 0))
		local y = math.clamp(offset.Y, 0, math.max(bounds.Y, 0))
		frame.Position = UDim2.fromOffset(x, y)
	end)
end

-- ===== GUI PARENT =====
-- Tries CoreGui first, like your SimpleBoxGui test, so the panel draws over Roblox's own UI.
-- Only scripts with enough permission can use CoreGui; if this one can't, it falls back to
-- PlayerGui so the panel still shows up. Old copies are removed first, so re-running is safe.
local guiLocation = "PlayerGui"

local function mountGui(gui, playerGui)
	pcall(function()
		local old = CoreGui:FindFirstChild(gui.Name)
		if old then
			old:Destroy()
		end
	end)
	local oldInPlayerGui = playerGui:FindFirstChild(gui.Name)
	if oldInPlayerGui then
		oldInPlayerGui:Destroy()
	end

	local ok = pcall(function()
		gui.Parent = CoreGui
	end)
	if ok and gui.Parent == CoreGui then
		guiLocation = "CoreGui"
	else
		guiLocation = "PlayerGui"
		gui.Parent = playerGui
	end
end

-- The FOV circle lives in its own ScreenGui so it stays visible when the panel is hidden.
-- It follows your cursor, because targets are picked by their distance to the cursor.
-- The ring has a slowly spinning gradient, and it brightens and thickens while you're aiming.
local function buildFovCircle(playerGui)
	local gui = Instance.new("ScreenGui")
	fovScreenGui = gui
	gui.Name = "AimFovCircle"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true -- so the circle lines up with the cursor position
	gui.DisplayOrder = 2147483646 -- just under the panel
	mountGui(gui, playerGui)

	local circle = Instance.new("Frame")
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.Position = UDim2.new(0.5, 0, 0.5, 0)
	circle.BackgroundTransparency = 1
	circle.BorderSizePixel = 0
	circle.Visible = false
	circle.Parent = gui
	Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

	local stroke = Instance.new("UIStroke")
	stroke.Color = FOV_CIRCLE_COLOR
	stroke.Thickness = 1.5
	stroke.Transparency = 0.25
	stroke.Parent = circle

	local ringGradient = Instance.new("UIGradient")
	ringGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, ACCENT_PINK),
		ColorSequenceKeypoint.new(0.33, ACCENT_VIO),
		ColorSequenceKeypoint.new(0.66, ACCENT_CYAN),
		ColorSequenceKeypoint.new(1, ACCENT_PINK),
	})
	ringGradient.Parent = stroke

	fovCircle = circle
	updateFovCircle()

	fovRenderConnection = RunService.RenderStepped:Connect(function()
		if selfDestructed then return end
		if showFov then
			local mousePos = UserInputService:GetMouseLocation()
			circle.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
			ringGradient.Rotation = (os.clock() * 90) % 360
			local isAiming = aiming and aimEnabled
			stroke.Thickness = isAiming and 2.5 or 1.5
			stroke.Transparency = isAiming and 0 or 0.25
		end
	end)
end


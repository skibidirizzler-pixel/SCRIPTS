end)

-- ===== MISC: HITBOX EXPANDER + WALKSPEED =====
-- Hitbox expander: makes other players' Head (or root part) bigger on YOUR screen only, so shots
-- and the triggerbot land more easily. Original sizes are saved and put back when it's turned off.
-- Walkspeed: pushes your character along with a LinearVelocity while you hold a movement key
-- (jumping and falling are left alone).
local SPEED_MIN, SPEED_MAX = 16, 1000
local HITBOX_MIN, HITBOX_MAX = 2, 50

local hitboxEnabled = false
local hitboxSize = 6
local hitboxTransparency = 0.6
local hitboxPart = "Head" -- "Head" or "Root"
local hitboxTeamCheck = true
local hitboxOriginals = {} -- [part] = { Size, Transparency, CanCollide }
local uiSetHitbox = nil

local speedEnabled = false
local speedTarget = 45
local uiSetSpeed = nil

local function restoreHitbox(part)
	local original = hitboxOriginals[part]
	hitboxOriginals[part] = nil
	if original and part.Parent then
		part.Size = original.Size
		part.Transparency = original.Transparency
		part.CanCollide = original.CanCollide
	end
end

local function restoreAllHitboxes()
	for part in pairs(hitboxOriginals) do
		restoreHitbox(part)
	end
end

local function updateHitboxes()
	if not hitboxEnabled then
		if next(hitboxOriginals) ~= nil then
			restoreAllHitboxes()
		end
		return
	end

	local seen = {}
	for _, other in ipairs(Players:GetPlayers()) do
		local character = other.Character
		if other ~= player and character and not (hitboxTeamCheck and isTeammate(other)) then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local part = character:FindFirstChild(hitboxPart == "Head" and "Head" or "HumanoidRootPart")
			if humanoid and humanoid.Health > 0 and part and part:IsA("BasePart") then
				seen[part] = true
				if not hitboxOriginals[part] then
					hitboxOriginals[part] = {
						Size = part.Size,
						Transparency = part.Transparency,
						CanCollide = part.CanCollide,
					}
				end
				part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
				part.Transparency = hitboxTransparency
				part.CanCollide = false
			end
		end
	end

	-- Put back anything that is no longer a target (left, died, teammate, or you picked another part)
	for part in pairs(hitboxOriginals) do
		if not seen[part] then
			restoreHitbox(part)
		end
	end
end

local MAX_HITBOX_ERRORS = 5
local hitboxErrorCount = 0
local hitboxConnection

hitboxConnection = RunService.Heartbeat:Connect(function()
	local ok, err = pcall(updateHitboxes)
	if ok then
		hitboxErrorCount = 0
		return
	end

	hitboxErrorCount += 1
	report("hitbox_runtime", "Hitbox expander error: " .. tostring(err), true)

	if hitboxErrorCount >= MAX_HITBOX_ERRORS then
		hitboxConnection:Disconnect()
		hitboxEnabled = false
		pcall(restoreAllHitboxes)
		if uiSetHitbox then
			uiSetHitbox(false)
		end
		local msg = "Hitbox expander stopped after " .. MAX_HITBOX_ERRORS .. " errors in a row. Last error: " .. tostring(err)
		warn(LOG_PREFIX .. msg)
		notify(msg)
	end
end)


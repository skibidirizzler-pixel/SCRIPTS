local speedAttachment = nil
local speedVelocity = nil
local speedConnection = nil
local speedErrorCount = 0

local function destroySpeedObjects()
	if speedVelocity then
		speedVelocity:Destroy()
		speedVelocity = nil
	end
	if speedAttachment then
		speedAttachment:Destroy()
		speedAttachment = nil
	end
end

local function setupSpeedObjects(root)
	destroySpeedObjects()

	speedAttachment = Instance.new("Attachment")
	speedAttachment.Name = "SpeedAtt"
	speedAttachment.Parent = root

	speedVelocity = Instance.new("LinearVelocity")
	speedVelocity.Name = "SpeedForce"
	speedVelocity.Attachment0 = speedAttachment
	speedVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	speedVelocity.MaxAxesForce = Vector3.zero
	speedVelocity.VectorVelocity = Vector3.zero
	speedVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	speedVelocity.Parent = root
end



local function speedStep()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end

	-- A new body after respawning needs new force objects
	if not speedVelocity or speedVelocity.Parent ~= root then
		setupSpeedObjects(root)
	end

	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude > 0.05 then
		speedVelocity.VectorVelocity = Vector3.new(moveDir.X * speedTarget, 0, moveDir.Z * speedTarget)
		speedVelocity.MaxAxesForce = Vector3.new(99999, 0, 99999)
	else
		speedVelocity.VectorVelocity = Vector3.zero
		speedVelocity.MaxAxesForce = Vector3.zero
	end
end

local function stopSpeed()
	if speedConnection then
		speedConnection:Disconnect()
		speedConnection = nil
	end
	destroySpeedObjects()
end

local function startSpeed()
	stopSpeed()
	speedConnection = RunService.Heartbeat:Connect(function()
		local ok, err = pcall(speedStep)
		if ok then
			speedErrorCount = 0
			return
		end

		speedErrorCount += 1
		report("speed_runtime", "Walkspeed error: " .. tostring(err), true)

		if speedErrorCount >= 5 then
			stopSpeed()
			speedEnabled = false
			if uiSetSpeed then
				uiSetSpeed(false)
			end
			local msg = "Walkspeed stopped after 5 errors in a row. Last error: " .. tostring(err)
			warn(LOG_PREFIX .. msg)
			notify(msg)
		end
	end)
end


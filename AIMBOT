	track.BorderSizePixel = 0
	track.Position = UDim2.new(0, 0, 0, 31)
	track.Size = UDim2.new(1, 0, 0, 6)
	track.Parent = container
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local fillGradient = Instance.new("UIGradient")
	fillGradient.Color = ColorSequence.new(accent, lighten(accent, 0.45))
	fillGradient.Parent = fill

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = Color3.fromRGB(250, 250, 255)
	knob.BorderSizePixel = 0
	knob.Size = UDim2.fromOffset(14, 14)
	knob.Parent = track
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local knobStroke = Instance.new("UIStroke")
	knobStroke.Color = accent
	knobStroke.Thickness = 2
	knobStroke.Parent = knob

	-- Invisible button over the track so it's easy to grab
	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.Position = UDim2.new(0, 0, 0, 20)
	hit.Size = UDim2.new(1, 0, 0, 26)
	hit.Parent = container

	local hovering = false
	local dragging = false

	local function refreshKnob()
		local size = (hovering or dragging) and 18 or 14
		tween(knob, 0.1, { Size = UDim2.fromOffset(size, size) })
		tween(knobStroke, 0.12, { Thickness = dragging and 3.5 or 2 })
		tween(valueLabel, 0.12, { TextSize = dragging and 15 or 13 })
	end

	hit.MouseEnter:Connect(function()
		hovering = true
		refreshKnob()
	end)
	hit.MouseLeave:Connect(function()
		hovering = false
		refreshKnob()
	end)

	local function setValue(v)
		v = math.clamp(v, min, max)
		local mult = 10 ^ decimals
		v = math.floor(v * mult + 0.5) / mult
		local alpha = (v - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = string.format("%." .. decimals .. "f%s", v, suffix or "")
		onChanged(v)
	end

	local function updateFromInput(input)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
		setValue(min + (max - min) * alpha)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			refreshKnob()
			updateFromInput(input)
			activeDrag = {
				update = updateFromInput,
				finish = function()
					dragging = false
					refreshKnob()
				end,
			}
		end
	end)

	setValue(default)
	return setValue
end

-- A color picker: saturation/brightness square, rainbow hue bar, hex readout and preset swatches.

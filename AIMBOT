-- Highlights targets through walls and (optionally) shows a name + distance label.
-- Note: Roblox only renders about 31 Highlights at once.
local espObjects = {} -- [adornee] = { highlight = Highlight, billboard = BillboardGui?, label = TextLabel? }

local function destroyEspObjects(objs)
	if objs.highlight then
		objs.highlight:Destroy()
	end
	if objs.billboard then
		objs.billboard:Destroy()
	end
end

local function clearEsp()
	for adornee, objs in pairs(espObjects) do
		destroyEspObjects(objs)
		espObjects[adornee] = nil
	end
end

-- Recolor the highlights that already exist (new ones pick up espColor when created)
local function applyEspColor()
	for _, objs in pairs(espObjects) do
		if objs.highlight then
			objs.highlight.FillColor = espColor
			objs.highlight.OutlineColor = espColor
		end
	end
end

-- Returns a list of { adornee, anchor, name, offset }
local function getEspTargets()
	local targets = {}
	local camera = workspace.CurrentCamera
	local camPos = camera and camera.CFrame.Position
	-- Targets farther away than the ESP max studs are skipped (and their ESP removed)
	local function inRange(part)
		return camPos == nil or (part.Position - camPos).Magnitude <= espMaxStuds
	end
	if TARGET_TAG then
		for _, part in ipairs(CollectionService:GetTagged(TARGET_TAG)) do
			if part:IsA("BasePart") and inRange(part) then
				table.insert(targets, {
					adornee = part,
					anchor = part,
					name = part.Name,
					offset = part.Size.Y / 2 + 1.5,
				})
			end
		end
	else
		for _, other in ipairs(Players:GetPlayers()) do
			local character = other.Character
			if other ~= player and character and not (espTeamCheck and isTeammate(other)) then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local anchor = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
				if humanoid and humanoid.Health > 0 and anchor and anchor:IsA("BasePart") and inRange(anchor) then
					table.insert(targets, {
						adornee = character,
						anchor = anchor,
						name = other.DisplayName,
						offset = 2.5,
					})
				end
			end
		end
	end
	return targets
end

local function createEspObjects(t)
	local objs = {}

	local highlight = Instance.new("Highlight")
	highlight.Name = "AimEspHighlight"
	highlight.Adornee = t.adornee
	highlight.FillColor = espColor
	highlight.FillTransparency = ESP_FILL_TRANSPARENCY
	highlight.OutlineColor = espColor
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = t.adornee
	objs.highlight = highlight

	if espShowNames or espShowDistance then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "AimEspLabel"
		billboard.Adornee = t.anchor
		billboard.AlwaysOnTop = true
		billboard.Size = UDim2.fromOffset(140, 30)
		billboard.StudsOffset = Vector3.new(0, t.offset, 0)
		billboard.Parent = t.anchor

		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 1, 0)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 13
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextStrokeTransparency = 0.4
		label.Text = t.name
		label.Parent = billboard

		objs.billboard = billboard
		objs.label = label
	end

	return objs
end

local function updateEsp()
	if not espEnabled then
		if next(espObjects) ~= nil then
			clearEsp()
		end
		return
	end

	local camera = workspace.CurrentCamera
	local seen = {}

	for _, t in ipairs(getEspTargets()) do
		seen[t.adornee] = true

		local objs = espObjects[t.adornee]
		if objs and (not objs.highlight.Parent) then
			-- something removed our highlight, rebuild it
			destroyEspObjects(objs)
			objs = nil
		end
		if not objs then
			objs = createEspObjects(t)
			espObjects[t.adornee] = objs
		end

		if objs.label and camera then
			local dist = math.floor((camera.CFrame.Position - t.anchor.Position).Magnitude + 0.5)
			if espShowNames and espShowDistance then
				objs.label.Text = string.format("%s (%d studs)", t.name, dist)
			elseif espShowDistance then
				objs.label.Text = string.format("%d studs", dist)
			else
				objs.label.Text = t.name
			end
		end
	end

	-- Remove ESP for targets that left, died, or respawned
	for adornee, objs in pairs(espObjects) do
		if not seen[adornee] then
			destroyEspObjects(objs)
			espObjects[adornee] = nil
		end
	end
end


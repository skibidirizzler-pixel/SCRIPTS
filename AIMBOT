	end)

	local function shutDownClient()
		if selfDestructed then return end
		selfDestructed = true
		aimEnabled, espEnabled, triggerEnabled = false, false, false
		hitboxEnabled, speedEnabled, aiming = false, false, false
		triggerSpamming = false

		pcall(function() RunService:UnbindFromRenderStep("AimLock") end)
		local connections = {
			triggerConnection, espConnection, hitboxConnection, speedConnection,
			fovRenderConnection, guiRenderConnection, inputBeganConnection,
			inputEndedConnection, focusReleasedConnection, characterAddedConnection,
		}
		for _, connection in ipairs(connections) do
			if connection then pcall(function() connection:Disconnect() end) end
		end
		triggerConnection, espConnection, hitboxConnection, speedConnection = nil, nil, nil, nil
		pcall(stopSpeed)
		pcall(restoreAllHitboxes)
		pcall(clearEsp)
		pcall(resetOffset)
		if fovScreenGui then pcall(function() fovScreenGui:Destroy() end) end
		if screenGui then pcall(function() screenGui:Destroy() end) end
		fovCircle, fovScreenGui, screenGui, panelFrame = nil, nil, nil, nil
	end


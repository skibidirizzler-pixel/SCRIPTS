local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local LOG_PREFIX = "[AimClient] "

-- ===== ERROR REPORTING =====
local lastReported = {}

local function notify(message)
	-- SetCore can fail if the CoreGui isn't ready yet, so never let it crash the script
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Aim client",
			Text = string.sub(message, 1, 150),
			Duration = 5,
		})
	end)
end

-- Throttled so a problem that happens every frame doesn't spam you
local function report(key, message, showOnScreen)
	local now = os.clock()
	if lastReported[key] and now - lastReported[key] < 5 then
		return
	end
	lastReported[key] = now
	warn(LOG_PREFIX .. message)
	if showOnScreen then
		notify(message)
	end
end


	hueHit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			updateHue(input)
			activeDrag = { update = updateHue, finish = function() end }
		end
	end)

	local swatches = {
		Color3.fromRGB(255, 60, 60),
		Color3.fromRGB(255, 150, 40),
		Color3.fromRGB(255, 230, 60),
		Color3.fromRGB(60, 220, 90),
		Color3.fromRGB(60, 220, 230),
		Color3.fromRGB(70, 120, 255),
		Color3.fromRGB(170, 90, 255),
		Color3.fromRGB(255, 110, 200),
		Color3.fromRGB(255, 255, 255),
	}

	for i, color in ipairs(swatches) do
		local swatch = Instance.new("TextButton")
		swatch.LayoutOrder = i
		swatch.Text = ""
		swatch.AutoButtonColor = false
		swatch.BackgroundColor3 = color
		swatch.BorderSizePixel = 0
		swatch.Size = UDim2.fromOffset(20, 20)
		swatch.Parent = presetRow
		Instance.new("UICorner", swatch).CornerRadius = UDim.new(0, 6)

		swatch.MouseEnter:Connect(function()
			tween(swatch, 0.12, { Size = UDim2.fromOffset(24, 24) })
		end)
		swatch.MouseLeave:Connect(function()
			tween(swatch, 0.12, { Size = UDim2.fromOffset(20, 20) })
		end)
		swatch.MouseButton1Click:Connect(function()
			hh, ss, vv = color:ToHSV()
			emit()
		end)
	end

	emit()

	-- Lets the presets set the color from code
	return function(color)
		hh, ss, vv = color:ToHSV()
		emit()
	end
end

-- A collapsible card with its own accent color. Click the name to open/close the dropdown
-- (it slides open and the arrow turns); the switch turns the feature on/off.
-- When it's on, the card gets a glowing outline, a lit accent bar and a faint tint.
-- Returns the dropdown body (put settings in it) and a function to set the switch from code.
local function createSection(parent, order, name, subtitle, accent, initialOn, onToggle, startOpen)
	local open = startOpen and true or false

	local section = Instance.new("Frame")
	section.Name = name .. "Section"
	section.LayoutOrder = order
	section.BackgroundColor3 = CARD_BG
	section.BackgroundTransparency = 0.25

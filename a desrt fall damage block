-- LocalScript - Fall Damage Blocker + Flight by fog1ch

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Create GUI for notifications
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FallDamageBlocker"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui
screenGui.IgnoreGuiInset = true

-- Anti-spam variables
local lastNotificationTime = 0
local notificationCooldown = 0.5

-- Function to create simple notification (with anti-spam)
local function createNotification(text)
    local currentTime = tick()
    if currentTime - lastNotificationTime < notificationCooldown then
        return
    end
    lastNotificationTime = currentTime
    
    local frame = Instance.new("Frame")
    frame.Name = "Notification"
    frame.Size = UDim2.new(0, 280, 0, 45)
    frame.Position = UDim2.new(1, 20, 0, 15)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Name = "Text"
    label.Size = UDim2.new(1, -40, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 14
    label.Parent = frame
    
    local icon = Instance.new("ImageLabel")
    icon.Name = "Icon"
    icon.Size = UDim2.new(0, 20, 0, 20)
    icon.Position = UDim2.new(1, -35, 0.5, -10)
    icon.BackgroundTransparency = 1
    icon.Image = "rbxassetid://6031068359"
    icon.ImageColor3 = Color3.fromRGB(0, 255, 100)
    icon.Parent = frame
    
    frame.Parent = screenGui
    frame:TweenPosition(UDim2.new(1, -300, 0, 15), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
    
    task.wait(1.2)
    frame:TweenPosition(UDim2.new(1, 20, 0, 15), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
    task.wait(0.3)
    frame:Destroy()
end

-- Small status icon
local function createStatusIcon()
    local iconFrame = Instance.new("Frame")
    iconFrame.Name = "StatusIcon"
    iconFrame.Size = UDim2.new(0, 32, 0, 32)
    iconFrame.Position = UDim2.new(1, -42, 0, 10)
    iconFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    iconFrame.BackgroundTransparency = 0.2
    iconFrame.BorderSizePixel = 0
    
    local iconCorner = Instance.new("UICorner")
    iconCorner.CornerRadius = UDim.new(0, 16)
    iconCorner.Parent = iconFrame
    
    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 20, 0, 20)
    icon.Position = UDim2.new(0.5, -10, 0.5, -10)
    icon.BackgroundTransparency = 1
    icon.Image = "rbxassetid://6031068359"
    icon.ImageColor3 = Color3.fromRGB(0, 255, 100)
    icon.Parent = iconFrame
    
    iconFrame.Parent = screenGui
end

-- FALL DAMAGE BLOCKER
local falldamage = ReplicatedStorage:FindFirstChild("falldamage")
local damageEvent = ReplicatedStorage:FindFirstChild("damage")
local getdamage = ReplicatedStorage:FindFirstChild("getdamage")

-- Create status icon
createStatusIcon()

-- Welcome message
task.spawn(function()
    createNotification("✅✅✅LOADED✅✅✅")
end)

-- Block fall damage event
if falldamage then
    local mt = getrawmetatable(falldamage)
    if mt then
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            
            if method == "FireServer" and self == falldamage then
                task.spawn(function()
                    -- createNotification("🛡️ Fall Damage Blocked") -- <- 🔴🔴CHANGE THIS IF YOU WANT A FALL DAMAGE BLOCKED MESSAGE 🔴🔴
                end)
                return
            end
            
            return oldNamecall(self, ...)
        end)
        
        setreadonly(mt, true)
    end
end

-- Block damage event
if damageEvent then
    local mt = getrawmetatable(damageEvent)
    if mt then
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if method == "FireServer" and self == damageEvent then
                if args[2] and type(args[2]) == "table" and args[2].type == "fall" then
                    task.spawn(function()
                        createNotification("🛡️ Fall Damage Blocked")
                    end)
                    return
                end
            end
            
            return oldNamecall(self, ...)
        end)
        
        setreadonly(mt, true)
    end
end

-- Block getdamage function
if getdamage then
    local oldInvoke = getdamage.InvokeServer
    getdamage.InvokeServer = function(...)
        local args = {...}
        if args[1] then
            local partName = args[1]
            if partName:find("Leg") or partName == "Torso" then
                task.spawn(function()
                    createNotification("⚔️ " .. partName .. " nullified")
                end)
                return {
                    name = partName,
                    damage = {
                        min = 0,
                        max = 0
                    }
                }
            end
        end
        return oldInvoke(...)
    end
end

print("no fall damage")
